@page "/products/create"
@using InventoryWeb.Models
@using InventoryWeb.Services
@inject ProductApiService ProductApiService
@inject NavigationManager Navigation

<h3>Crear producto</h3>

@* Este formulario utiliza product como modelo y ejecuta CreateProduct() cuando las validaciones sean correctas. *@
<EditForm Model="product" OnValidSubmit="SaveProduct">
    @* hace que Blazor utilice las validaciones que ya tenemos en CreateProductDto *@
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Nombre</label>
        <InputText class="form-control" @bind-Value="product.Name" />
        <ValidationMessage For="@(() => product.Name)" />
    </div>

    <div class="mb-3">
        <label>Descripción</label>
        <InputText class="form-control" @bind-Value="product.Description" />
        <ValidationMessage For="@(() => product.Description)" />
    </div>

    <div class="mb-3">
        <label>Precio</label>
        <InputNumber class="form-control" @bind-Value="product.Price" />
        <ValidationMessage For="@(() => product.Price)" />
    </div>

    <div class="mb-3">
        <label>Stock</label>
        <InputNumber class="form-control" @bind-Value="product.Stock" />
        <ValidationMessage For="@(() => product.Stock)" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@saving">
        @(saving ? "Guardando..." : "Guardar")
    </button>
</EditForm>

@if (!string.IsNullOrEmpty(message))
{
    <p class="mt-3">@message</p>
}

@code {
    private CreateProductDto product = new();
    private string message = "";
    private bool saving = false;

    private async Task SaveProduct()
    {
        saving = true;

        var response = await ProductApiService.CreateProductAsync(product);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/products");
        }
        else
        {
            message = "No se pudo crear el producto.";
            saving = false;
        }
    }
}